BOT_TOKEN=replace-with-BotFather-token
WEBHOOK_SECRET=replace-with-at-least-32-random-url-safe-characters
WEBHOOK_BASE_URL=https://your-service.onrender.com
DATABASE_URL=postgresql://taskflow:local-development-only@localhost:5432/taskflow
USER_MAX_ID=111111111
USER_MAX_NAME=Макс
USER_VIKA_ID=222222222
USER_VIKA_NAME=Вика
DEFAULT_TIMEZONE=Europe/Helsinki
DEFAULT_WEEKLY_TARGET=10000
RATING_NOTIFICATION_COOLDOWN_MINUTES=60
RATING_NOTIFICATION_DEBOUNCE_SECONDS=5
ENVIRONMENT=development
LOG_LEVEL=INFO
# false only for local development/tests; production requires true and an HTTPS origin.
REGISTER_WEBHOOK=false
# Only use a dedicated disposable database with a name ending in _test.
TEST_DATABASE_URL=postgresql://taskflow:local-development-only@localhost:5432/taskflow_test

# Reserved for a future chat widget; true is rejected until compatibility is verified.
TELEGRAM_HTML_WIDGET_ENABLED=false
